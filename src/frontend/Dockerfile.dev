# Dockerfile para desarrollo del frontend React
FROM node:18-alpine

# Establecer directorio de trabajo
WORKDIR /app

# Instalar dependencias del sistema
RUN apk add --no-cache git

# Copiar archivos de dependencias
COPY package*.json ./

# Instalar dependencias (incluyendo devDependencies)
RUN npm install

# Crear archivo .env para desarrollo
RUN echo "REACT_APP_API_URL=http://localhost:8000/api/v1" > .env.local
RUN echo "GENERATE_SOURCEMAP=false" >> .env.local
RUN echo "CHOKIDAR_USEPOLLING=true" >> .env.local

# Exponer puerto 3000
EXPOSE 3000

# Comando para desarrollo con hot reload
CMD ["npm", "start"]

